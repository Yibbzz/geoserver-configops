{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yibbzz/geoserver_cloud/gisdata/schema/v1alpha1.json",
  "title": "gisdata resource (v1alpha1)",
  "description": "One resource of the dataset spec: docs/spec/datasets.md",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "gisdata/v1alpha1"
    },
    "kind": {
      "enum": [
        "Project",
        "Source",
        "Dataset",
        "Layer",
        "LayerGroup",
        "Style",
        "Settings",
        "Service",
        "Role",
        "Group",
        "User",
        "AccessRule",
        "Store"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/resourceName"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Project"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/project"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Source"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Dataset"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/dataset"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Layer"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "LayerGroup"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/layerGroup"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Style"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/style"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Settings"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/settings"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind",
          "metadata"
        ],
        "properties": {
          "kind": {
            "const": "Service"
          },
          "metadata": {
            "properties": {
              "name": {
                "const": "wms"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/service_wms"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind",
          "metadata"
        ],
        "properties": {
          "kind": {
            "const": "Service"
          },
          "metadata": {
            "properties": {
              "name": {
                "const": "wfs"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/service_wfs"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind",
          "metadata"
        ],
        "properties": {
          "kind": {
            "const": "Service"
          },
          "metadata": {
            "properties": {
              "name": {
                "const": "wcs"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/service_wcs"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind",
          "metadata"
        ],
        "properties": {
          "kind": {
            "const": "Service"
          },
          "metadata": {
            "properties": {
              "name": {
                "const": "wmts"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/service_wmts"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Service"
          }
        }
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "name": {
                "enum": [
                  "wms",
                  "wfs",
                  "wcs",
                  "wmts"
                ],
                "description": "wms, wfs, wcs or wmts"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Role"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/role"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Group"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/group"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "User"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/user"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "AccessRule"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/accessRule"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Store"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/store"
          }
        }
      }
    }
  ],
  "$defs": {
    "resourceName": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "lowercase letters, digits and dashes, starting and ending with a letter or digit"
    },
    "geoserverName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
      "description": "letters, digits, _ . and -, not starting with a digit"
    },
    "tableName": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]{0,62}$",
      "description": "lowercase letters, digits and _, not starting with a digit, at most 63 characters"
    },
    "secretRef": {
      "type": "object",
      "required": [
        "secret"
      ],
      "additionalProperties": false,
      "properties": {
        "secret": {
          "$ref": "#/$defs/resourceName"
        }
      }
    },
    "crs": {
      "type": "string",
      "pattern": "^EPSG:[0-9]+$"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schedule": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "manual"
          ]
        },
        {
          "pattern": "^\\S+( \\S+){4}$",
          "description": "A five-field cron expression"
        }
      ],
      "description": "daily, weekly, monthly, manual, or a five-field cron expression such as '0 3 * * 1'"
    },
    "project": {
      "type": "object",
      "required": [
        "geoserver",
        "database",
        "workspace"
      ],
      "additionalProperties": false,
      "properties": {
        "geoserver": {
          "type": "object",
          "required": [
            "url",
            "credentials"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "credentials": {
              "$ref": "#/$defs/secretRef"
            }
          }
        },
        "database": {
          "type": "object",
          "required": [
            "jndi",
            "connection"
          ],
          "additionalProperties": false,
          "properties": {
            "jndi": {
              "type": "string",
              "pattern": "^java:comp/env/jdbc/\\S+$"
            },
            "connection": {
              "$ref": "#/$defs/secretRef"
            },
            "schemas": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "live": {
                  "$ref": "#/$defs/tableName"
                },
                "staging": {
                  "$ref": "#/$defs/tableName"
                },
                "backup": {
                  "$ref": "#/$defs/tableName"
                }
              }
            }
          }
        },
        "workspace": {
          "$ref": "#/$defs/geoserverName"
        },
        "crs": {
          "$ref": "#/$defs/crs"
        },
        "backups": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "os-downloads",
            "url",
            "ckan",
            "ogc-api-features",
            "wfs"
          ]
        },
        "credentials": {
          "$ref": "#/$defs/secretRef"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "The source's address: a CKAN portal (e.g. https://data.gov.uk), a WFS or OGC API endpoint"
        }
      }
    },
    "dataset": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/resourceName"
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "description": "Which download of a CKAN package to load: a resource ID or name"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "update": {
          "$ref": "#/$defs/schedule"
        },
        "tables": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/tableName"
              },
              "crs": {
                "$ref": "#/$defs/crs"
              }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dropInvalidGeometries": {
              "type": "boolean"
            },
            "minRows": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "$ref": "#/$defs/resourceName"
        },
        "table": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "A key under the dataset's tables"
            },
            {
              "type": "object",
              "required": [
                "schema",
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "schema": {
                  "$ref": "#/$defs/tableName"
                },
                "name": {
                  "$ref": "#/$defs/tableName"
                }
              }
            }
          ]
        },
        "name": {
          "$ref": "#/$defs/geoserverName"
        },
        "workspace": {
          "$ref": "#/$defs/geoserverName"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "keywords": {
          "$ref": "#/$defs/keywords"
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "enabled": {
          "type": "boolean"
        },
        "advertised": {
          "type": "boolean"
        },
        "queryable": {
          "type": "boolean"
        },
        "cache": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gridsets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "formats": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            }
          ]
        },
        "attribution": {
          "type": "string"
        },
        "store": {
          "$ref": "#/$defs/resourceName"
        },
        "resource": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "required": [
          "dataset"
        ]
      },
      "then": {
        "properties": {
          "table": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "table": {
            "type": "object"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "table"
          ]
        },
        {
          "required": [
            "store"
          ]
        }
      ],
      "description": "a table (with or without dataset), or store"
    },
    "layerGroup": {
      "type": "object",
      "required": [
        "layers"
      ],
      "additionalProperties": false,
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/resourceName"
              },
              {
                "type": "object",
                "required": [
                  "layer"
                ],
                "additionalProperties": false,
                "properties": {
                  "layer": {
                    "$ref": "#/$defs/resourceName"
                  },
                  "style": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "mode": {
          "enum": [
            "single",
            "named",
            "container",
            "opaque"
          ]
        },
        "name": {
          "$ref": "#/$defs/geoserverName"
        },
        "workspace": {
          "$ref": "#/$defs/geoserverName"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "keywords": {
          "$ref": "#/$defs/keywords"
        },
        "cache": {
          "type": "boolean"
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "\\.(sld|mbstyle|css)$"
        },
        "workspace": {
          "$ref": "#/$defs/geoserverName"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "$ref": "#/$defs/geoserverName"
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contactPerson": {
              "type": "string"
            },
            "contactOrganization": {
              "type": "string"
            },
            "contactPosition": {
              "type": "string"
            },
            "contactEmail": {
              "type": "string"
            },
            "contactVoice": {
              "type": "string"
            },
            "contactFacsimile": {
              "type": "string"
            },
            "addressType": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "addressDeliveryPoint": {
              "type": "string"
            },
            "addressCity": {
              "type": "string"
            },
            "addressState": {
              "type": "string"
            },
            "addressPostalCode": {
              "type": "string"
            },
            "addressCountry": {
              "type": "string"
            },
            "onlineResource": {
              "type": "string"
            },
            "welcome": {
              "type": "string"
            }
          }
        },
        "proxyBaseUrl": {
          "type": "string"
        },
        "useHeadersProxyURL": {
          "type": "boolean"
        },
        "numDecimals": {
          "type": "integer"
        },
        "charset": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "verboseExceptions": {
          "type": "boolean"
        },
        "localWorkspaceIncludesPrefix": {
          "type": "boolean"
        },
        "showCreatedTimeColumnsInAdminList": {
          "type": "boolean"
        },
        "showModifiedTimeColumnsInAdminList": {
          "type": "boolean"
        },
        "showModifiedUserAdminList": {
          "type": "boolean"
        },
        "global": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "globalServices": {
              "type": "boolean"
            },
            "resourceErrorHandling": {
              "enum": [
                "OGC_EXCEPTION_REPORT",
                "SKIP_MISCONFIGURED_LAYERS"
              ]
            },
            "webUIMode": {
              "enum": [
                "DEFAULT",
                "REDIRECT",
                "DO_NOT_REDIRECT"
              ]
            },
            "xmlPostRequestLogBufferSize": {
              "type": "integer"
            },
            "featureTypeCacheSize": {
              "type": "integer"
            },
            "trailingSlashMatch": {
              "type": "boolean"
            },
            "allowStoredQueriesPerWorkspace": {
              "type": "boolean"
            },
            "geoserver": {
              "type": "object",
              "description": "any other field, as GeoServer's REST API names it"
            },
            "catalogMode": {
              "enum": [
                "hide",
                "mixed",
                "challenge"
              ]
            }
          }
        },
        "geoserver": {
          "type": "object",
          "description": "any other field, as GeoServer's REST API names it"
        }
      }
    },
    "service_wms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "keywords": {
          "$ref": "#/$defs/keywords"
        },
        "maintainer": {
          "type": "string"
        },
        "fees": {
          "type": "string"
        },
        "accessConstraints": {
          "type": "string"
        },
        "onlineResource": {
          "type": "string"
        },
        "citeCompliant": {
          "type": "boolean"
        },
        "schemaBaseURL": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "geoserver": {
          "type": "object",
          "description": "any other field, as GeoServer's REST API names it"
        },
        "srs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bboxForEachCRS": {
          "type": "boolean"
        },
        "interpolation": {
          "enum": [
            "Nearest",
            "Bilinear",
            "Bicubic"
          ]
        },
        "watermark": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "position": {
              "enum": [
                "TOP_LEFT",
                "TOP_CENTER",
                "TOP_RIGHT",
                "MID_LEFT",
                "MID_CENTER",
                "MID_RIGHT",
                "BOT_LEFT",
                "BOT_CENTER",
                "BOT_RIGHT"
              ]
            },
            "transparency": {
              "type": "integer"
            }
          }
        },
        "maxBuffer": {
          "type": "integer"
        },
        "maxRequestMemory": {
          "type": "integer"
        },
        "maxRenderingTime": {
          "type": "integer"
        },
        "maxRenderingErrors": {
          "type": "integer"
        },
        "maxRequestedDimensionValues": {
          "type": "integer"
        },
        "getFeatureInfoMimeTypeCheckingEnabled": {
          "type": "boolean"
        },
        "getMapMimeTypeCheckingEnabled": {
          "type": "boolean"
        },
        "dynamicStylingDisabled": {
          "type": "boolean"
        },
        "featuresReprojectionDisabled": {
          "type": "boolean"
        },
        "defaultGroupStyleEnabled": {
          "type": "boolean"
        },
        "transformFeatureInfoDisabled": {
          "type": "boolean"
        },
        "autoEscapeTemplateValues": {
          "type": "boolean"
        },
        "cacheConfiguration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxEntries": {
              "type": "integer"
            },
            "maxEntrySize": {
              "type": "integer"
            }
          }
        },
        "remoteStyleMaxRequestTime": {
          "type": "integer"
        },
        "remoteStyleTimeout": {
          "type": "integer"
        }
      }
    },
    "service_wfs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "keywords": {
          "$ref": "#/$defs/keywords"
        },
        "maintainer": {
          "type": "string"
        },
        "fees": {
          "type": "string"
        },
        "accessConstraints": {
          "type": "string"
        },
        "onlineResource": {
          "type": "string"
        },
        "citeCompliant": {
          "type": "boolean"
        },
        "schemaBaseURL": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "geoserver": {
          "type": "object",
          "description": "any other field, as GeoServer's REST API names it"
        },
        "srs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serviceLevel": {
          "enum": [
            "BASIC",
            "TRANSACTIONAL",
            "COMPLETE"
          ]
        },
        "maxFeatures": {
          "type": "integer"
        },
        "featureBounding": {
          "type": "boolean"
        },
        "canonicalSchemaLocation": {
          "type": "boolean"
        },
        "encodeFeatureMember": {
          "type": "boolean"
        },
        "hitsIgnoreMaxFeatures": {
          "type": "boolean"
        },
        "includeWFSRequestDumpFile": {
          "type": "boolean"
        },
        "disableStoredQueriesManagement": {
          "type": "boolean"
        },
        "allowGlobalQueries": {
          "type": "boolean"
        },
        "simpleConversionEnabled": {
          "type": "boolean"
        },
        "getFeatureOutputTypeCheckingEnabled": {
          "type": "boolean"
        }
      }
    },
    "service_wcs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "keywords": {
          "$ref": "#/$defs/keywords"
        },
        "maintainer": {
          "type": "string"
        },
        "fees": {
          "type": "string"
        },
        "accessConstraints": {
          "type": "string"
        },
        "onlineResource": {
          "type": "string"
        },
        "citeCompliant": {
          "type": "boolean"
        },
        "schemaBaseURL": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "geoserver": {
          "type": "object",
          "description": "any other field, as GeoServer's REST API names it"
        },
        "srs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gmlPrefixing": {
          "type": "boolean"
        },
        "latLon": {
          "type": "boolean"
        },
        "subsamplingEnabled": {
          "type": "boolean"
        },
        "maxInputMemory": {
          "type": "integer"
        },
        "maxOutputMemory": {
          "type": "integer"
        },
        "defaultDeflateCompressionLevel": {
          "type": "integer"
        },
        "maxRequestedDimensionValues": {
          "type": "integer"
        },
        "overviewPolicy": {
          "enum": [
            "IGNORE",
            "NEAREST",
            "QUALITY",
            "SPEED"
          ]
        }
      }
    },
    "service_wmts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "keywords": {
          "$ref": "#/$defs/keywords"
        },
        "maintainer": {
          "type": "string"
        },
        "fees": {
          "type": "string"
        },
        "accessConstraints": {
          "type": "string"
        },
        "onlineResource": {
          "type": "string"
        },
        "citeCompliant": {
          "type": "boolean"
        },
        "schemaBaseURL": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "geoserver": {
          "type": "object",
          "description": "any other field, as GeoServer's REST API names it"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "GeoServer role names"
        }
      }
    },
    "user": {
      "type": "object",
      "required": [
        "password"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "password": {
          "type": "object",
          "required": [
            "secret",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "secret": {
              "$ref": "#/$defs/resourceName"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "GeoServer role names"
        }
      }
    },
    "accessRule": {
      "type": "object",
      "required": [
        "roles"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "layer"
          ]
        },
        {
          "required": [
            "service"
          ]
        },
        {
          "required": [
            "rest"
          ]
        }
      ],
      "description": "exactly one of layer, service or rest",
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "GeoServer role names, or * for everyone"
        },
        "layer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workspace": {
              "type": "string",
              "minLength": 1
            },
            "layer": {
              "type": "string",
              "minLength": 1
            },
            "access": {
              "enum": [
                "read",
                "write",
                "admin"
              ]
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "service": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rest": {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "GET",
                  "HEAD",
                  "POST",
                  "PUT",
                  "DELETE",
                  "PATCH"
                ]
              }
            }
          }
        }
      }
    },
    "store": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "cog",
            "wms",
            "wmts",
            "wfs",
            "postgis"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "the COG's address (https://, s3://, gs://, az://), or the service's capabilities address"
        },
        "connection": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          },
          "description": "connection parameters, as GeoServer names them"
        },
        "credentials": {
          "$ref": "#/$defs/secretRef"
        },
        "name": {
          "$ref": "#/$defs/geoserverName"
        },
        "workspace": {
          "$ref": "#/$defs/geoserverName"
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}

{
  "dataStore": {
    "name": "postgres",
    "type": "PostGIS (JNDI)",
    "enabled": true,
    "workspace": {
      "name": "test",
      "href": "http://localhost:9090/rest/workspaces/test.json"
    },
    "connectionParameters": {
      "entry": [
        {
          "@key": "schema",
          "$": "data_layers"
        },
        {
          "@key": "Estimated extends",
          "$": "true"
        },
        {
          "@key": "fetch size",
          "$": "1000"
        },
        {
          "@key": "encode functions",
          "$": "true"
        },
        {
          "@key": "Expose primary keys",
          "$": "false"
        },
        {
          "@key": "Support on the fly geometry simplification",
          "$": "true"
        },
        {
          "@key": "Batch insert size",
          "$": "1"
        },
        {
          "@key": "preparedStatements",
          "$": "true"
        },
        {
          "@key": "Method used to simplify geometries",
          "$": "FAST"
        },
        {
          "@key": "jndiReferenceName",
          "$": "java:comp/env/jdbc/mypostgis"
        },
        {
          "@key": "dbtype",
          "$": "postgis"
        },
        {
          "@key": "namespace",
          "$": "test_uri"
        },
        {
          "@key": "Loose bbox",
          "$": "false"
        }
      ]
    },
    "_default": false,
    "disableOnConnFailure": false,
    "featureTypes": "http://localhost:9090/rest/workspaces/test/datastores/postgres/featuretypes.json"
  }
}
